# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
KAFKA_PORT=9092
KAFKA_UI_PORT=9088

# Services run on the host during development and reach infra via localhost.
KAFKA_BROKERS=localhost:9092

# KAFKA_CLIENT_ID defaults to the service name.
KAFKA_CONNECTION_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7
PROCESSED_MESSAGES_RETENTION_DAYS=14
HANDLER_MAX_ATTEMPTS=5
HANDLER_MAX_BACKOFF_MS=30000

# Service ports
CONSUMER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
KITCHEN_SERVICE_PORT=8083
RESTAURANT_SERVICE_PORT=8084
ACCOUNTING_SERVICE_PORT=8085
ORDER_HISTORY_SERVICE_PORT=8086
API_GATEWAY_PORT=8087
DELIVERY_SERVICE_PORT=8089

# Service databases
CONSUMER_DATABASE_URL=postgres://consumer_service:consumer_service@localhost:5432/consumer_db
RESTAURANT_DATABASE_URL=postgres://restaurant_service:restaurant_service@localhost:5432/restaurant_db
ORDER_DATABASE_URL=postgres://order_service:order_service@localhost:5432/order_db
KITCHEN_DATABASE_URL=postgres://kitchen_service:kitchen_service@localhost:5432/kitchen_db
DELIVERY_DATABASE_URL=postgres://delivery_service:delivery_service@localhost:5432/delivery_db
ACCOUNTING_DATABASE_URL=postgres://accounting_service:accounting_service@localhost:5432/accounting_db
ORDER_HISTORY_DATABASE_URL=postgres://order_history_service:order_history_service@localhost:5432/order_history_db

# Logging
LOG_LEVEL=info

# Consumer Service: authentication
# Base64 of an Ed25519 private key (PKCS#8 PEM). Required.
JWT_SIGNING_KEY=
JWT_ISSUER=ftgo-consumer-service
JWT_AUDIENCE=ftgo
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
CONSUMER_DATABASE_POOL_SIZE=10

# Restaurant Service
RESTAURANT_DATABASE_POOL_SIZE=10

# Order Service
ORDER_DATABASE_POOL_SIZE=10

# Kitchen Service
KITCHEN_DATABASE_POOL_SIZE=10

# Accounting Service
ACCOUNTING_DATABASE_POOL_SIZE=10

# Delivery Service
DELIVERY_DATABASE_POOL_SIZE=10

# Access token verification (every service except the Consumer Service)
# JWT_ISSUER and JWT_AUDIENCE above apply here too.
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
