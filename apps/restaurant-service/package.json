{
  "name": "@ftgo/restaurant-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0"
  },
  "dependencies": {
    "@ftgo/common": "workspace:*",
    "@ftgo/contracts": "workspace:*",
    "@ftgo/messaging": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typebox": "^1.3.37"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsc -b && pnpm run --parallel \"/^dev:/\"",
    "dev:compile": "tsc -b -w --preserveWatchOutput",
    "dev:run": "node --enable-source-maps --env-file-if-exists=../../.env --watch-path=dist dist/main.js | pino-pretty",
    "migrate": "node --enable-source-maps --env-file-if-exists=../../.env dist/migrate.js"
  }
}
